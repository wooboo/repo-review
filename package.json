{
  "name": "repo-review",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun scripts/build-collector.ts && bun --bun vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "bun scripts/build-collector.ts && bun --bun vite build && cp -r src/db/migrations .output/server/migrations",
    "preview": "vite preview",
    "start": "bun .output/server/index.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "collector:build": "bun scripts/build-collector.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.2.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.14",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "drizzle-orm": "^0.45.4",
    "effect": "4.1",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "0.8.6",
    "@tanstack/router-cli": "^1.132.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "7.0.2",
    "vite": "^8.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
